{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "hunch",
  "description": "Specs, tests and reviews for the judgments your software makes with a model.",
  "colors": {
    "primary": "#B45309",
    "light": "#F59E0B",
    "dark": "#92400E"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      { "label": "GitHub", "href": "https://github.com/oneryalcin/hunch" }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "cursor", "mcp"]
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": ["index", "quickstart", "concepts"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/write-a-spec",
          "guides/agent-traces",
          "guides/review",
          "guides/test-in-ci",
          "guides/change-a-spec",
          "guides/projects",
          "guides/judge-in-your-app",
          "guides/shadow",
          "guides/pydantic",
          "guides/engines",
          "guides/scale",
          "guides/server"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/spec",
          "reference/cli",
          "reference/python",
          "reference/server-api",
          "reference/environment",
          "reference/store"
        ]
      },
      {
        "group": "More",
        "pages": ["how-the-numbers-work", "results", "contribute"]
      }
    ]
  },
  "footer": {
    "socials": { "github": "https://github.com/oneryalcin/hunch" }
  }
}
