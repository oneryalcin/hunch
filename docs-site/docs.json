{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "hunch",
  "description": "Specs, tests and reviews for the judgments your software makes with a model.",
  "colors": {
    "primary": "#405A60",
    "light": "#7D969B",
    "dark": "#405A60"
  },
  "favicon": "/logo/hunch-favicon.svg",
  "logo": {
    "light": "/logo/hunch-light.svg",
    "dark": "/logo/hunch-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/oneryalcin/hunch"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/write-a-spec",
              "guides/review",
              "guides/test-in-ci",
              "guides/change-a-spec",
              "guides/use-in-your-app"
            ]
          }
        ]
      },
      {
        "tab": "Cookbooks",
        "icon": "flask",
        "groups": [
          {
            "group": "Cookbooks",
            "pages": [
              "cookbooks/index",
              "cookbooks/claude-code-sessions",
              "cookbooks/command-guard",
              "cookbooks/banking-intents",
              "cookbooks/swe-patches",
              "cookbooks/amazon-reviews"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Files and commands",
            "pages": [
              "reference/spec",
              "reference/cli",
              "reference/python",
              "reference/environment"
            ]
          },
          {
            "group": "Running hunch",
            "pages": [
              "reference/engines",
              "reference/projects",
              "reference/store",
              "reference/server",
              "reference/server-api"
            ]
          },
          {
            "group": "Statistics",
            "pages": [
              "reference/how-the-numbers-work"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/oneryalcin/hunch"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://fuguai.mintlify.site/logo/hunch-social.png",
      "twitter:image": "https://fuguai.mintlify.site/logo/hunch-social.png",
      "twitter:card": "summary_large_image"
    }
  }
}
