{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/oneryalcin/hunch/main/src/hunch/results.schema.json",
  "title": "hunch test results",
  "description": "What `hunch test` measured: .hunch/target/<tested path>.json, and the receipt `test --receipt` writes beside a spec. Version 2 separates measurements from configured acceptance checks; version 1 receipts remain readable. Reference: https://fuguai.mintlify.site/reference/files",
  "type": "object",
  "required": [
    "version",
    "command",
    "passed",
    "judgments"
  ],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "command": {
      "const": "test"
    },
    "at": {
      "type": "string"
    },
    "git_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "passed": {
      "type": "boolean",
      "description": "No blocking configured check failed; may be true when no acceptance checks were configured. Read assessment for the interpretation."
    },
    "assessment": {
      "enum": ["failed", "warning", "unassessed", "passed", "measured", "no_gold"],
      "description": "Version 2: what the completed test established."
    },
    "sample": {
      "type": [
        "integer",
        "null"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "description": "The --target the test ran with; null when the specs ran as written. Absent from receipts, which are always as written"
    },
    "cost": {
      "type": [
        "number",
        "null"
      ]
    },
    "judgments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "spec_hash",
          "model",
          "questions"
        ],
        "properties": {
          "spec_hash": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "The engine; null for a union, which asks nothing"
          },
          "rows": {
            "type": "integer"
          },
          "assessment": {
            "enum": ["failed", "warning", "unassessed", "passed", "measured", "no_gold"]
          },
          "questions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "rows"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "choice",
                    "noul",
                    "score"
                  ]
                },
                "rows": {
                  "type": "integer"
                },
                "gold": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "type": "integer"
                    },
                    "source": {
                      "type": "integer"
                    },
                    "review": {
                      "type": "integer"
                    },
                    "excluded": {
                      "type": "integer"
                    }
                  }
                },
                "accuracy": {
                  "type": "object",
                  "required": [
                    "value",
                    "basis"
                  ],
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Accuracy"
                    },
                    "ci": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "95% interval [low, high]"
                    },
                    "basis": {
                      "enum": [
                        "estimate",
                        "gold"
                      ]
                    },
                    "reviewed": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "reviewed": {
                            "type": "integer"
                          },
                          "of": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                },
                "weighted": {
                  "type": "boolean",
                  "description": "Whether the accuracy uses population sampling weights"
                },
                "unavailable_checks": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Configured acceptance checks that could not be evaluated"
                },
                "calibration_error": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "auroc": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "act": {
                  "type": "object",
                  "properties": {
                    "threshold": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "yes": {
                              "type": "number"
                            },
                            "no": {
                              "type": "number"
                            }
                          }
                        }
                      ]
                    },
                    "automated": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Share of all rows acted on"
                    },
                    "judged": {
                      "type": "integer"
                    },
                    "wrong": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Share of acted-on rows with gold that are wrong"
                    }
                  }
                },
                "dial": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "threshold"
                    ],
                    "properties": {
                      "threshold": {
                        "type": "number"
                      },
                      "automated": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1,
                        "description": ""
                      },
                      "wrong": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1,
                        "description": ""
                      },
                      "yes": {
                        "type": "object",
                        "properties": {
                          "automated": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Share of rows acted on"
                          },
                          "wrong": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Share of those that are wrong"
                          }
                        }
                      },
                      "no": {
                        "type": "object",
                        "properties": {
                          "automated": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Share of rows acted on"
                          },
                          "wrong": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Share of those that are wrong"
                          }
                        }
                      }
                    }
                  }
                },
                "mistakes": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "most_confident": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "got": {
                            "type": "string"
                          },
                          "p": {
                            "type": "number"
                          },
                          "gold": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "check",
                      "passed"
                    ],
                    "properties": {
                      "check": {
                        "type": "string",
                        "description": "The test key, e.g. min_accuracy"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "limit": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "severity": {
                        "enum": [
                          "error",
                          "warn"
                        ]
                      }
                    }
                  }
                },
                "spot_checks": {
                  "type": "integer"
                },
                "needs_context": {
                  "type": "integer"
                },
                "recall": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "yes_rows"
                  ],
                  "description": "noul: share of gold-yes rows a person still sees when confident \"no\" answers are set aside",
                  "properties": {
                    "yes_rows": {
                      "type": "integer"
                    },
                    "at_act": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "threshold",
                        "value",
                        "ci",
                        "read"
                      ],
                      "properties": {
                        "threshold": {
                          "type": "number"
                        },
                        "value": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "ci": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "read": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Share of all rows a person reads (weighted when the source has weights)"
                        }
                      },
                      "description": "At the spec's act bar for no"
                    },
                    "lowest_act": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "threshold",
                        "value",
                        "ci",
                        "read"
                      ],
                      "properties": {
                        "threshold": {
                          "type": "number"
                        },
                        "value": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "ci": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "read": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Share of all rows a person reads (weighted when the source has weights)"
                        }
                      },
                      "description": "The lowest bar for no whose interval's lower bound meets min_recall"
                    }
                  }
                },
                "baseline": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "rows",
                    "said_yes",
                    "accuracy",
                    "recall",
                    "precision",
                    "auroc",
                    "model",
                    "model_ahead"
                  ],
                  "description": "noul with baseline: the rule and the model scored on the same gold rows, weighted alike; null where a share has no rows",
                  "properties": {
                    "rule": {
                      "type": [
                        "string",
                        "object"
                      ],
                      "description": "As in the spec"
                    },
                    "rows": {
                      "type": "integer"
                    },
                    "said_yes": {
                      "type": "integer"
                    },
                    "accuracy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "recall": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Share of gold-yes rows it says yes on"
                    },
                    "precision": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Share of its yes answers that gold says yes"
                    },
                    "auroc": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "model": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "accuracy",
                        "recall",
                        "precision",
                        "auroc"
                      ],
                      "properties": {
                        "accuracy": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "recall": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Share of gold-yes rows it says yes on"
                        },
                        "precision": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Share of its yes answers that gold says yes"
                        },
                        "auroc": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "description": "The model's label (yes at p(yes) >= 0.5) on the same rows; auroc from p(yes)"
                    },
                    "model_ahead": {
                      "type": "boolean",
                      "description": "The model's accuracy is above the rule's"
                    }
                  }
                }
              }
            }
          },
          "multi": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "multi"
                },
                "rows": {
                  "type": "integer"
                },
                "gold_rows": {
                  "type": "integer"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exact_set_accuracy": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mean_overlap": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unavailable_checks": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "check",
                      "passed"
                    ],
                    "properties": {
                      "check": {
                        "type": "string",
                        "description": "The test key, e.g. min_accuracy"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "limit": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "severity": {
                        "enum": [
                          "error",
                          "warn"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "rule"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "unavailable_checks": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "rows": {
                  "type": "integer"
                },
                "fired": {
                  "type": "integer"
                },
                "rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Share of rows where the rule holds on answers; weighted when the source has weights"
                },
                "ci": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "With sampling weights: 95% interval [low, high] of the weighted rate"
                },
                "effective_rows": {
                  "type": "number",
                  "description": "With sampling weights: Kish's effective sample size"
                },
                "gold": {
                  "type": "object",
                  "properties": {
                    "basis": {
                      "type": "string"
                    },
                    "rows": {
                      "type": "integer"
                    }
                  }
                },
                "gold_rate": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "of": {
                      "type": "integer"
                    },
                    "rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ci": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "95% interval [low, high]"
                    },
                    "effective_rows": {
                      "type": "number",
                      "description": "With sampling weights: Kish's effective sample size"
                    }
                  }
                },
                "missed": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "of": {
                      "type": "integer"
                    },
                    "rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ci": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "95% interval [low, high]"
                    },
                    "effective_rows": {
                      "type": "number",
                      "description": "With sampling weights: Kish's effective sample size"
                    }
                  }
                },
                "false_alarms": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "of": {
                      "type": "integer"
                    },
                    "rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ci": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "95% interval [low, high]"
                    },
                    "effective_rows": {
                      "type": "number",
                      "description": "With sampling weights: Kish's effective sample size"
                    }
                  }
                },
                "by": {
                  "type": "string",
                  "description": "The metric's by column"
                },
                "no_group": {
                  "type": "integer",
                  "description": "Rows with no value in by, left out of the groups"
                },
                "groups": {
                  "type": "object",
                  "description": "Per value of by: the rule on answers (weighted when the source has weights), and on gold",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "rows",
                      "fired",
                      "rate",
                      "ci"
                    ],
                    "properties": {
                      "rows": {
                        "type": "integer"
                      },
                      "fired": {
                        "type": "integer"
                      },
                      "rate": {
                        "type": "number"
                      },
                      "ci": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "95% interval [low, high]"
                      },
                      "effective_rows": {
                        "type": "number",
                        "description": "With sampling weights: Kish's effective sample size"
                      },
                      "gold_rate": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "integer"
                          },
                          "of": {
                            "type": "integer"
                          },
                          "rate": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "ci": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "95% interval [low, high]"
                          }
                        }
                      }
                    }
                  }
                },
                "higher": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "difference": {
                      "type": "number",
                      "description": "First group's rate minus the second's"
                    },
                    "ci": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "95% interval of the difference [low, high] (Newcombe)"
                    },
                    "gold": {
                      "type": "object",
                      "description": "The same difference on gold, when both groups have gold",
                      "properties": {
                        "difference": {
                          "type": "number"
                        },
                        "ci": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2,
                          "description": "95% interval of the difference [low, high] (Newcombe)"
                        }
                      }
                    }
                  }
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "check",
                      "passed"
                    ],
                    "properties": {
                      "check": {
                        "type": "string",
                        "description": "The test key, e.g. min_accuracy"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "limit": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "severity": {
                        "enum": [
                          "error",
                          "warn"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "passed"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "severity": {
                  "enum": [
                    "error",
                    "warn"
                  ]
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "question": {
                        "type": "string"
                      },
                      "expected": {
                        "type": "string"
                      },
                      "got": {
                        "type": "string"
                      },
                      "p": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "passed": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
